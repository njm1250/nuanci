# compose.prod.yaml에서 읽는 서버 환경변수
# 여러 주소는 쉼표로: api.example.com, old.example.com
API_DOMAIN=api.example.com
POSTGRES_PASSWORD=
NUANCI_ADMIN_ID=admin
NUANCI_ADMIN_PASSWORD=
# 구글 로그인 (구글 클라우드 콘솔 → OAuth 클라이언트 ID, 웹 애플리케이션)
# 승인된 리디렉션 URI: https://<사이트 주소>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NUANCI_SITE_URL=https://nuanci.vercel.app
