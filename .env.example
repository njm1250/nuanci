# compose.prod.yaml에서 읽는 서버 환경변수
# 여러 주소는 쉼표로: api.example.com, old.example.com
API_DOMAIN=api.example.com
POSTGRES_PASSWORD=
NUANCI_ADMIN_ID=admin
NUANCI_ADMIN_PASSWORD=
# 구글 로그인 (구글 클라우드 콘솔 → OAuth 클라이언트 ID, 웹 애플리케이션)
# 승인된 리디렉션 URI: https://<사이트 주소>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NUANCI_SITE_URL=https://nuanci.vercel.app
# 웹 푸시(VAPID). openssl로 만든 P-256 키를 base64url로. 비어 있으면 알림이 꺼진다
NUANCI_PUSH_PUBLIC_KEY=
NUANCI_PUSH_PRIVATE_KEY=
NUANCI_PUSH_SUBJECT=mailto:
# 하려던 영어를 가장 가까운 보기에 대 보는 Gemini. 비어 있으면 모으기만 한다
NUANCI_GEMINI_API_KEY=
NUANCI_GEMINI_MODEL=gemini-3.1-flash-lite
